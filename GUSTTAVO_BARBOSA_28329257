<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contato - Design Moderno</title>
    
    <!-- Importando a fonte moderna 'Inter' do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f7f6; 
            color: #333;
            margin: 0;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            box-sizing: border-box;
        }
        .w3-content {
            max-width: 600px;
            margin: auto;
        }
        .container {
            background-color: #ffffff;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            width: 100%;
            box-sizing: border-box;
        }

        header {
            text-align: center;
            margin-bottom: 35px;
        }

        h1 {
            color: #1f2937;
            margin-top: 0;
            font-size: 2.2em;
            font-weight: 600;
        }

        p {
            color: #6b7280;
            line-height: 1.6;
            font-size: 1.05em;
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 20px; 
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        label {
            font-weight: 500;
            color: #4b5563;
            font-size: 0.95em;
        }

        input, textarea {
            padding: 14px 16px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            font-family: inherit;
            font-size: 1em;
            background-color: #f9fafb;
            transition: all 0.3s ease;
            outline: none;
        }

        input:focus, textarea:focus {
            border-color: #3b82f6;
            background-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
        }

        button {
            background-color: #3b82f6; 
            color: white;
            border: none;
            padding: 16px 20px;
            border-radius: 10px;
            font-size: 1.1em;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.1s;
            margin-top: 15px;
        }

        button:hover {
            background-color: #2563eb; 
        }

        button:active {
            transform: translateY(2px);
        }
        @media (max-width: 480px) {
            .container {
                padding: 25px;
            }
            h1 {
                font-size: 1.8em;
            }
        }
    </style>
</head>
<body>
    <main class="w3-content container">
        <header>
            <h1>Fale Conosco</h1>
            <p>Tem alguma dúvida</p>
        </header>

        <form class="contact-form" action="#" method="POST" onsubmit="event.preventDefault(); alert('Em um ambiente real, sua mensagem seria enviada!');">
            
            <div class="form-group">
                <label for="name">Seu Nome</label>
                <input type="text" id="name" name="name" required placeholder="Digite seu nome completo">
            </div>
            
            <div class="form-group">
                <label for="email">Seu E-mail</label>
                <input type="email" id="email" name="email" required placeholder="exemplo@email.com">
            </div>
            
            <div class="form-group">
                <label for="message">Mensagem</label>
                <textarea id="message" name="message" rows="5" required placeholder="Como podemos ajudar você hoje?"></textarea>
            </div>
            
            <button type="submit">Enviar Mensagem</button>
            
        </form>

    </main>

</body>
</html>
